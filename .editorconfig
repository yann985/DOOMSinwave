root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{zs,txt}]
indent_style = tab
indent_size = 4

[*.{ps1,bat,cmd}]
end_of_line = crlf
indent_style = tab
indent_size = 4

[*.ps1]
# Windows PowerShell 5.1 lit les scripts sans BOM comme de l'ANSI (accents cassés).
charset = utf-8-bom

[*.{md,yml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
